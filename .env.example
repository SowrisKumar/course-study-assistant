# Copy to .env and fill in only the LLM backends you use. .env is git-ignored.
# Check what works with:  uv run python -m study_assistant.llm --check

OPENAI_API_KEY=
# Gemini has a free tier: get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Where Ollama runs (default http://localhost:11434). Docker uses DOCKER_OLLAMA_HOST instead (docker-compose.yml).
# OLLAMA_HOST=http://localhost:11434

# Optional: override the default models
# OPENAI_MODEL=gpt-5.6-luna
# GEMINI_MODEL=gemini-3.6-flash
# OLLAMA_MODEL=llama3.1:8b
# FLAN_MODEL=google/flan-t5-base
